# Copy to .env for local dev. On Railway, set these in the service Variables tab.

PORT=5100
NODE_ENV=development                # Railway: production

# MongoDB Atlas connection string (include the /qrmenu db name)
MONGODB_URI=

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth secrets — use long random strings in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# The customer-facing app URL — QR codes encode this domain (Railway: your Vercel URL)
PUBLIC_BASE_URL=http://localhost:5180

# Allowed frontend origins, comma-separated (Railway: your Vercel URL)
CLIENT_ORIGIN=http://localhost:5180
